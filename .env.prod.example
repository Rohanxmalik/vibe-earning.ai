# Production environment template — copy to `.env` next to docker-compose.prod.yml
# (or load into your host's secret manager). NEVER commit the filled-in file.
# Generate strong secrets:  openssl rand -hex 32

# --- Core (required) ---
POSTGRES_USER=kbi
POSTGRES_PASSWORD=__CHANGE_ME__strong-random__
POSTGRES_DB=kbi
# If using a MANAGED Postgres/Redis (recommended), set these to the provider URLs
# instead of relying on the bundled containers:
# DATABASE_URL=postgresql://user:pass@your-managed-host:5432/kbi?schema=public
# REDIS_URL=rediss://user:pass@your-managed-redis:6379
AUTH_JWT_SECRET=__CHANGE_ME__openssl-rand-hex-32__
ADMIN_API_KEY=__CHANGE_ME__break-glass-only__

# --- Auth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Payments (from each provider dashboard — see docs/launch/PAYMENTS_SETUP.md) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# --- Email (transactional) ---
RESEND_API_KEY=
EMAIL_FROM=vibearning <noreply@your-domain.com>
PORTAL_BASE_URL=https://your-portal-domain.com

# --- Hardening (set in prod) ---
# NOTE: the API refuses to boot in production if AUTH_JWT_SECRET / ADMIN_API_KEY / FRAUD_IP_SALT
# (and the webhook secret for any configured PSP) are unset or left at their dev defaults (C4).
FRAUD_IP_SALT=__CHANGE_ME__random__
FRAUD_SWEEP_INTERVAL_MS=900000     # >0 enables periodic auto-void of fraud clusters (15 min); keep ON at launch
CORS_ORIGINS=https://your-portal-domain.com   # REQUIRED: unset = deny all cross-origin in prod
SENTRY_DSN=
LOG_LEVEL=info
THROTTLE_LIMIT=300                 # global per-IP requests/min
AUTH_THROTTLE_LIMIT=10             # tighter per-IP/min limit on login/register (brute-force guard)
# Impression tokens bind every /events impression to a real /serve response (anti click-fraud).
EVENTS_TOKEN_SECRET=__CHANGE_ME__openssl-rand-hex-32__
EVENTS_REQUIRE_TOKEN=true          # reject events without a valid server-issued token
BCRYPT_COST=12                     # password hashing work factor (OWASP ≥12)

# --- Money knobs (optional; defaults shown) ---
# PAYOUT_MIN_PAISE=10000          # ₹100 minimum withdrawal
# LEDGER_DEV_SHARE_BPS=5000       # 50% developer revenue share

# --- Fast-launch payout guardrails (default OFF; turn ON at launch while fraud controls harden) ---
PAYOUT_REQUIRE_APPROVAL=true       # payouts wait for admin release (POST /admin/payouts/:id/approve)
PAYOUT_HOLD_DAYS=7                 # no cash-out until an account is 7 days old (first-payout hold)
PAYOUT_DAILY_CAP_PAISE=500000      # ₹5,000/account/day ceiling (0 = disabled)

# --- Object storage for brand logos (see docs/launch/DEPLOY.md → Object storage) ---
# Local disk is ephemeral on most hosts, so use an S3-compatible bucket in prod.
VIBEARNING_STORAGE=s3
VIBEARNING_S3_BUCKET=vibearning-logos
VIBEARNING_PUBLIC_URL=https://cdn.your-domain.com   # public base for stored logo URLs (bucket/CDN)
VIBEARNING_S3_REGION=ap-south-1
VIBEARNING_S3_ACCESS_KEY_ID=
VIBEARNING_S3_SECRET_ACCESS_KEY=
# R2 / Supabase / MinIO only (omit for AWS S3):
# VIBEARNING_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# VIBEARNING_S3_FORCE_PATH_STYLE=true
# VIBEARNING_S3_PREFIX=logos/

# --- Portal (build-time, baked into the image) ---
NEXT_PUBLIC_API_BASE=https://your-api-domain.com
